HOST=127.0.0.1
PORT=8787
# Required outside explicit private-network development mode.
WORKER_AUTH_TOKEN=replace-with-at-least-32-random-bytes
# Development only: unauthenticated requests are still restricted to loopback/private callers.
WORKER_ALLOW_UNAUTHENTICATED=false
BROWSER_POOL_SIZE=1
BROWSER_MAX_CONTEXTS=4
